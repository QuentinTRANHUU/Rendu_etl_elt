# =====================================================================
# CONFIGURATION DE LA SIMULATION (DILEMME DU PRISONNIER)
# =====================================================================
# Nombre de tours par affrontement/match (ex: 5, 10, 50)
NB_TOURS_PAR_PARTIE=5
# Nombre de tours passés que l'IA peut garder en mémoire (Fenêtre de contexte)
DUREE_MEMOIRE_AGENTS=5
# Matrice de gains utilisée
MATRICE_GAINS_DEFAULT = {
    ("COOPERER", "COOPERER"): (3, 3),
    ("COOPERER", "TRAHIR"): (0, 5),
    ("TRAHIR", "COOPERER"): (5, 0),
    ("TRAHIR", "TRAHIR"): (1, 1)
}

# =====================================================================
# CONFIGURATION DU LLM (OLLAMA)
# =====================================================================
# Nom du modèle à utiliser (ex: llama3:8b, mistral, gemma)
MODELE_LLM=llama3:8b
# Température du modèle (plus elle est basse, plus l'IA est stable et suit les consignes)
LLM_TEMPERATURE=0.3

# =====================================================================
# CHEMINS DES FICHIERS
# =====================================================================
CHEMIN_PROMPTS_JSON=src/prompts_regles_et_profils.json
CHEMIN_DOSSIER_DATA=data